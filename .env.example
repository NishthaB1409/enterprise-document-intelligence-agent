# Copy to `.env` and fill in — `.env` is read at startup by app/config.py, and
# is gitignored. Never put a real key in this file; it is the committed template.
# Everything here has a working default except the API key for your provider.

# --- Generation (required for /query) ---------------------------------------
# The only vendor key this service needs: embeddings, BM25, and reranking all
# run locally. Without a key, /ingest still works and /query returns 503.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Only for Azure OpenAI, a proxy, or another OpenAI-compatible gateway.
# OPENAI_BASE_URL=

# Writes the cited answer. Must support strict structured outputs (gpt-4o-mini
# or newer): the citation contract depends on schema-constrained JSON, not on
# parsing prose out of a paragraph.
ANSWER_MODEL=gpt-4o-mini

# Ceiling on one answer, reasoning tokens included. Too low truncates the JSON
# rather than shortening the prose.
ANSWER_MAX_TOKENS=8000

# --- Vector store -----------------------------------------------------------
# No Docker? Set this to a directory and Qdrant runs embedded, in-process. Same
# engine, same code path, nothing else to install or start. It takes precedence
# over QDRANT_URL, and holds an exclusive lock on the directory — one process
# only, so run uvicorn without --reload.
# QDRANT_PATH=./data/qdrant

# `docker compose up` serves Qdrant here. Running the app outside Compose
# against the Compose Qdrant works unchanged; inside Compose it is http://qdrant:6333.
QDRANT_URL=http://localhost:6333
# Only for Qdrant Cloud. Leave unset for the local container.
# QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# --- Embeddings -------------------------------------------------------------
# Runs locally (ONNX). No API key, no per-document cost. ~130MB downloaded on
# first use and cached; set EMBEDDING_CACHE_DIR to keep it across restarts.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=/var/cache/fastembed

# --- Retrieval and chunking -------------------------------------------------
# How many chunks the answer is allowed to draw on.
RETRIEVAL_TOP_K=5

# dense | hybrid. Hybrid adds BM25 alongside the embeddings and fuses the two
# rankings. It defaults to off because it measured *worse* than dense on the
# evaluation corpus (0.658 MRR against 0.702) — see eval/README.md for why, and
# re-run `python -m eval.retrieval_eval` against your own documents before
# changing it. Switching to hybrid requires re-ingesting: BM25 vectors are built
# at ingest time, and Qdrant cannot add a sparse index to an existing collection.
RETRIEVAL_MODE=dense
# How deep each arm of a hybrid search looks before fusion. Ignored when
RETRIEVAL_CANDIDATES=30

# A cross-encoder re-scores the shortlist, reading question and chunk together.
# Also off by default on the same evidence: it cost 0.05 MRR on exact-token
# questions and returned 0.005 on paraphrased ones. Downloads ~80MB on first use.
RERANK_ENABLED=false
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Measured in whitespace words, not BPE tokens. See the note in app/config.py.
CHUNK_SIZE_WORDS=350
CHUNK_OVERLAP_WORDS=50
MAX_UPLOAD_BYTES=26214400

# --- Agentic graph ----------------------------------------------------------
# Route -> retrieve -> grade -> (rewrite -> retry) -> generate -> critique,
# instead of one retrieve-then-generate pass. Costs 3-5 model calls per question
# rather than 1, so it is opt-in and unmeasured: whether it produces *better
# answers* needs the phase 5 harness, which does not exist yet. What it
# demonstrably adds today is an off-topic question that gets declined instead of
# answered, irrelevant chunks dropped before they can be cited, one retry with a
# rephrased query, and a confidence score on every answer.
AGENT_ENABLED=false

# Each node is one extra model call per query and can be turned off on its own.
# AGENT_ROUTE=true
# AGENT_GRADE=true
# AGENT_CRITIQUE=true

# Retries when grading finds nothing relevant. Each costs two more model calls,
# and a second rewrite is usually further from what was asked, not closer.
# AGENT_MAX_REWRITES=1

# The model the graph's classification steps use. Cheaper than ANSWER_MODEL on
# purpose: routing, grading and rewriting are yes/no judgements and paraphrase,
# and running four of them per query on the answering model is the easiest way
# to make the graph cost several times what it should.
# AGENT_MODEL=gpt-4o-mini

# --- Observability (optional) -----------------------------------------------
# Leave blank to run without tracing: spans are still created, just discarded.
# `docker compose up` does not start Langfuse — point these at Langfuse Cloud
# or your own instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Tags every trace, so dev/staging/prod stay separable in one Langfuse project.
ENVIRONMENT=development
# Set from the git SHA in CI so a regression traces back to a build.
# RELEASE=
