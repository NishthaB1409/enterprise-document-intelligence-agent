# Secrets. `.env.example` is the committed template; `.env` is yours and never
# leaves this machine.
.env
.env.*
!.env.example

# Environments
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local model weights, if EMBEDDING_CACHE_DIR points inside the repo
.cache/

# Embedded Qdrant's on-disk state, when QDRANT_PATH points inside the repo.
# It holds an exclusive .lock file and a sqlite database of whatever has been
# ingested — machine-local, conflict-prone, and potentially customer content.
data/
